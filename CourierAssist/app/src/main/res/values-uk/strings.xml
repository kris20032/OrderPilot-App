<resources>
    <string name="app_name">CourierAssist</string>
    <string name="accessibility_service_description">CourierAssist аналізує пропозиції доставки та показує оверлей прибутковості.</string>
    <string name="btn_start">Старт</string>
    <string name="btn_stop">Стоп</string>
    <string name="status_running">Активний</string>
