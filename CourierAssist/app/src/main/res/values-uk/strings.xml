    <string name="toast_projection_lost">Запис екрану було перервано. Натисніть Старт щоб відновити.</string>

    <!-- SetupActivity -->
    <string name="setup_subtitle">Налаштуйте додаток для правильної роботи у фоновому режимі.</string>
