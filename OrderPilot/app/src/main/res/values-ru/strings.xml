    <!-- Manufacturer card -->
    <string name="setup_manufacturer_title">%s: дополнительные настройки</string>
    <string name="setup_manufacturer_subtitle">Рекомендуется — предотвращает остановку приложения в фоновом режиме</string>

    <!-- Samsung -->
    <string name="setup_samsung_step1">Откройте информацию о приложении → нажмите «Батарея» → установите «Без ограничений»</string>
    <string name="setup_samsung_step1_btn">Открыть информацию о приложении</string>
    <string name="setup_samsung_step2">Настройки → Обслуживание устройства → Батарея → Ограничения фонового использования → удалите OrderPilot из списков «Спящие приложения» и «Глубоко спящие»</string>
    <string name="setup_samsung_step2_btn">Открыть настройки батареи</string>
    <string name="setup_samsung_step3">Отключите «Переводить неиспользуемые приложения в спящий режим» на том же экране</string>

    <!-- Xiaomi / Redmi / POCO -->
    <string name="setup_xiaomi_step1">Включите Автозапуск — позволяет приложению запускаться автоматически после перезагрузки телефона</string>
    <string name="setup_xiaomi_step1_btn">Открыть Автозапуск</string>
    <string name="setup_xiaomi_step2">Настройки → Приложения → OrderPilot → Экономия батареи → установите «Без ограничений»</string>
    <string name="setup_xiaomi_step2_btn">Открыть настройки батареи</string>
    <string name="setup_xiaomi_step3">Откройте список последних приложений (квадратная кнопка внизу) → найдите OrderPilot → потяните вниз или удерживайте → нажмите замок</string>

    <!-- Huawei / Honor -->
    <string name="setup_huawei_step1">Настройки → Батарея → Запуск приложений → найдите OrderPilot → отключите «Управлять автоматически» → включите все 3 переключателя вручную (автозапуск, работа в фоне, фоновая активность)</string>
    <string name="setup_huawei_step1_btn">Открыть настройки батареи</string>
    <string name="setup_huawei_step2">Настройки → Приложения → OrderPilot → Батарея → «Не оптимизировать»</string>
    <string name="setup_huawei_step2_btn">Открыть информацию о приложении</string>

    <!-- Oppo / Realme -->
    <string name="setup_oppo_step1">Информация о приложении → Батарея → включите «Разрешить работу в фоне»</string>
    <string name="setup_oppo_step1_btn">Открыть информацию о приложении</string>
    <string name="setup_oppo_step2">Информация о приложении → включите «Автоматический запуск» (Auto-launch)</string>
    <string name="setup_oppo_step2_btn">Открыть информацию о приложении</string>
    <string name="setup_oppo_step3">Настройки → Батарея → Управление батареей → OrderPilot → включите автозапуск и фоновую активность</string>

    <!-- OnePlus -->
    <string name="setup_oneplus_step1">Настройки → Приложения → Специальный доступ → Оптимизация батареи → найдите OrderPilot → установите «Не оптимизировать»</string>
    <string name="setup_oneplus_step1_btn">Открыть оптимизацию батареи</string>
    <string name="setup_oneplus_step2">Настройки → Батарея → Расширенная оптимизация → отключите «Глубокая оптимизация»</string>
    <string name="setup_oneplus_step2_btn">Открыть настройки батареи</string>
    <string name="setup_oneplus_step3">Откройте список последних приложений → найдите OrderPilot → удерживайте → нажмите замок</string>

