    <!-- Manufacturer card -->
    <string name="setup_manufacturer_title">%s: additional settings</string>
    <string name="setup_manufacturer_subtitle">Recommended — prevents the app from being killed in the background</string>

    <!-- Samsung -->
    <string name="setup_samsung_step1">Open app info → tap "Battery" → set "Unrestricted"</string>
    <string name="setup_samsung_step1_btn">Open app info</string>
    <string name="setup_samsung_step2">Settings → Device Care → Battery → Background usage limits → remove OrderPilot from "Sleeping apps" and "Deep sleeping apps" lists</string>
    <string name="setup_samsung_step2_btn">Open battery settings</string>
    <string name="setup_samsung_step3">Disable "Put unused apps to sleep" on the same screen</string>

    <!-- Xiaomi / Redmi / POCO -->
    <string name="setup_xiaomi_step1">Enable Autostart — allows the app to start automatically after phone restart</string>
    <string name="setup_xiaomi_step1_btn">Open Autostart</string>
    <string name="setup_xiaomi_step2">Settings → Apps → OrderPilot → Battery Saver → set "No restrictions"</string>
    <string name="setup_xiaomi_step2_btn">Open battery settings</string>
    <string name="setup_xiaomi_step3">Open recent apps list (square button at the bottom) → find OrderPilot → swipe down or long-press → tap the lock icon</string>

    <!-- Huawei / Honor -->
    <string name="setup_huawei_step1">Settings → Battery → App Launch → find OrderPilot → turn off "Manage automatically" → enable all 3 toggles manually (auto-launch, secondary launch, run in background)</string>
    <string name="setup_huawei_step1_btn">Open battery settings</string>
    <string name="setup_huawei_step2">Settings → Apps → OrderPilot → Battery → "Don\'t optimize"</string>
    <string name="setup_huawei_step2_btn">Open app info</string>

    <!-- Oppo / Realme -->
    <string name="setup_oppo_step1">App info → Battery → enable "Allow background activity"</string>
    <string name="setup_oppo_step1_btn">Open app info</string>
    <string name="setup_oppo_step2">App info → enable "Auto-launch"</string>
    <string name="setup_oppo_step2_btn">Open app info</string>
    <string name="setup_oppo_step3">Settings → Battery → Battery management → OrderPilot → enable auto-launch and background activity</string>

    <!-- OnePlus -->
    <string name="setup_oneplus_step1">Settings → Apps → Special Access → Battery Optimization → find OrderPilot → set "Don\'t optimize"</string>
    <string name="setup_oneplus_step1_btn">Open battery optimization</string>
    <string name="setup_oneplus_step2">Settings → Battery → Advanced optimization → disable "Deep optimization"</string>
    <string name="setup_oneplus_step2_btn">Open battery settings</string>
    <string name="setup_oneplus_step3">Open recent apps list → find OrderPilot → long-press → tap the lock icon</string>

