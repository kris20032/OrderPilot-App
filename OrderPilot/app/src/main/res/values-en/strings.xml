<resources>
    <string name="app_name">OrderPilot</string>
    <string name="accessibility_service_description">OrderPilot reads on-screen content only from the courier apps Uber Driver, Wolt Courier, Glovo Courier and Bolt Food in order to detect new offers and display the calculated hourly rate (PLN/h) on an overlay. Screen data is processed exclusively on your device, is never transmitted off-device and is never persistently stored. You can disable the service at any time in system settings.</string>
