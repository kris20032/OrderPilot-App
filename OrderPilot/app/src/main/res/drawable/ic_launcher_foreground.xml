<?xml version="1.0" encoding="utf-8"?>
<!--
    OrderPilot logo A1 — Arrow-Up Reticle (Final Balanced, post-QA)
    Spec: docs/branding/01_logo_decision.md sekcja 6, 02_qa_fixes.md
    Viewport 1024 = master canvas 1:1 (Android render scale: 108dp)
    Elementy: ring + 2 ticki (L/R) + head (triangle) + shaft (rounded rect)
    QA fixes applied: shift strzałki -8px (tip y=192), shaft rx=6
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Ring (stroke only, cx=512 cy=512 r=260 stroke=56) -->
    <path
        android:pathData="M 252,512 a 260,260 0 1,0 520,0 a 260,260 0 1,0 -520,0 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF6B2C"
        android:strokeWidth="56" />

    <!-- Tick L (x=180 y=500 w=44 h=24 rx=4) -->
    <path
        android:pathData="M 184,500 h 36 a 4,4 0 0,1 4,4 v 16 a 4,4 0 0,1 -4,4 h -36 a 4,4 0 0,1 -4,-4 v -16 a 4,4 0 0,1 4,-4 Z"
        android:fillColor="#FF6B2C" />

    <!-- Tick R (x=800 y=500 w=44 h=24 rx=4) -->
    <path
        android:pathData="M 804,500 h 36 a 4,4 0 0,1 4,4 v 16 a 4,4 0 0,1 -4,4 h -36 a 4,4 0 0,1 -4,-4 v -16 a 4,4 0 0,1 4,-4 Z"
        android:fillColor="#FF6B2C" />

    <!-- Head (triangle: tip 512,192 → base 574,320 | 450,320) -->
    <path
        android:pathData="M 512,192 L 574,320 L 450,320 Z"
        android:fillColor="#FF6B2C" />

    <!-- Shaft (x=494 y=320 w=36 h=328 rx=6) -->
    <path
        android:pathData="M 500,320 h 24 a 6,6 0 0,1 6,6 v 316 a 6,6 0 0,1 -6,6 h -24 a 6,6 0 0,1 -6,-6 v -316 a 6,6 0 0,1 6,-6 Z"
        android:fillColor="#FF6B2C" />

</vector>
