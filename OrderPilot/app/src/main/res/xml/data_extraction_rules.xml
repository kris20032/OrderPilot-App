<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup/transfer rules.
    Odpowiednik backup_rules.xml dla nowszego systemu; te same kategorie
    danych (user preferences ✓, disclosure consent ✗).

    KD5 Play Store: disclosureAcceptedVersion nie może być restored między
    urządzeniami — user musi ponownie zaakceptować Prominent Disclosure.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="order_pilot_settings.xml"/>
        <exclude domain="sharedpref" path="order_pilot_disclosure.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="order_pilot_settings.xml"/>
        <exclude domain="sharedpref" path="order_pilot_disclosure.xml"/>
    </device-transfer>
</data-extraction-rules>
