<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup rules (Android 6+, API 23+).

    Włączamy kopię preferencji użytkownika (progi kolorów, język, motyw,
    pozycja belki itd.) — użytkownik po przywróceniu telefonu odzyskuje
    swoje ustawienia. Uprawnienia systemowe (accessibility, overlay,
    battery) nie są backupowane przez Android — użytkownik i tak przechodzi
    wizard ponownie, więc flaga monitoring_state w tym samym pliku jest
    nieszkodliwa (bez grantów wizard i tak startuje od zera).

    WYKLUCZENIA:
    - order_pilot_disclosure.xml: KD5 Play Store wymaga świeżej zgody disclosure
      po przywróceniu na nowym urządzeniu. Plik zarezerwowany na Phase 3.
-->
<full-backup-content>
    <!-- Tylko ustawienia użytkownika są backupowane. order_pilot_disclosure.xml
         jest automatycznie wykluczone bo nie ma go w include (KD5). -->
    <include domain="sharedpref" path="order_pilot_settings.xml"/>
</full-backup-content>
