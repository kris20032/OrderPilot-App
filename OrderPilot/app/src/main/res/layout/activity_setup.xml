<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Nagłówek -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/on_background"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_subtitle"
            android:textSize="15sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Krok 1: Overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_overlay_status"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="✗"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="@color/status_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_overlay_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_overlay_desc"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="36dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/setup_open_settings"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="36dp"
                    app:cornerRadius="20dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Krok 2: Accessibility -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_accessibility_status"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="✗"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="@color/status_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_accessibility_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_accessibility_desc"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="36dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/setup_open_settings"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="36dp"
                    app:cornerRadius="20dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Krok 3: Battery optimization -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_battery_status"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="✗"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="@color/status_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_battery_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_battery_desc"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="36dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/setup_disable_restrictions"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="36dp"
                    app:cornerRadius="20dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Krok 4: Karta producenta (dynamiczne kroki per marka) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_manufacturer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="!"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="@color/status_yellow" />

                    <TextView
                        android:id="@+id/tv_manufacturer_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_manufacturer_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="36dp" />

                <!-- Kontener na dynamiczne kroki -->
                <LinearLayout
                    android:id="@+id/container_manufacturer_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="36dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Przycisk Kontynuuj -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/setup_continue"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            app:cornerRadius="28dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>