<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Nagłówek postępu (widoczny tylko na krokach uprawnień) -->
    <LinearLayout
        android:id="@+id/layout_progress_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/primary_dark" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface_variant" />

    </LinearLayout>

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:measureAllChildren="false">

        <!-- ═══ 0. POWITANIE: belka nad makietą zlecenia ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_welcome_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_welcome_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <!-- Makieta ekranu zlecenia + PRAWDZIWA belka nad nią -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline_variant"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="52dp"
                            android:paddingBottom="20dp">

                            <View
                                android:layout_width="180dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_skeleton_line" />

                            <View
                                android:layout_width="120dp"
                                android:layout_height="14dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_skeleton_line" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="18dp"
                                android:background="@drawable/bg_skeleton_line" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="18dp"
                                android:background="@drawable/bg_accept_pill"
                                android:gravity="center"
                                android:text="@string/setup_welcome_mock_accept"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Belka (prawdziwy widok produkcyjny) — nachodzi na górę makiety -->
                    <FrameLayout
                        android:id="@+id/fl_belka_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/setup_welcome_legend"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/setup_welcome_footer"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_welcome_start"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/setup_welcome_start"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══ 1. OVERLAY ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_step_overlay" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/setup_step_overlay_title"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_step_overlay_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="@string/setup_step_overlay_how"
                        android:textSize="14sp"
                        android:lineSpacingExtra="7dp"
                        android:textColor="@color/on_surface" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_overlay_granted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/setup_step_granted"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_green"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_overlay_open"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/setup_step_overlay_btn"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══ 2. ACCESSIBILITY ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_step_accessibility" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/setup_step_accessibility_title"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_step_accessibility_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="@string/setup_step_accessibility_how"
                        android:textSize="14sp"
                        android:lineSpacingExtra="7dp"
                        android:textColor="@color/on_surface" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/setup_step_accessibility_note"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_accessibility_granted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/setup_step_granted"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_green"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_accessibility_open"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/setup_step_accessibility_btn"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══ 3. POWIADOMIENIA (API 33+) ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_step_notifications" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/setup_step_notifications_title"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_step_notifications_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_notifications_settings_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_step_notifications_denied_hint"
                    android:textSize="13sp"
                    android:textColor="@color/status_red"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_notifications_granted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/setup_step_granted"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_green"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/setup_step_notifications_btn"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══ 4. BATERIA ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_step_battery" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/setup_step_battery_title"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_step_battery_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="@string/setup_step_battery_how"
                        android:textSize="14sp"
                        android:lineSpacingExtra="7dp"
                        android:textColor="@color/on_surface" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_battery_granted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/setup_step_granted"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_green"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_battery_open"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/setup_step_battery_btn"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══ 5. WSKAZÓWKI PRODUCENTA (OEM) ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_step_oem" />

                <TextView
                    android:id="@+id/tv_oem_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_step_oem_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:id="@+id/container_manufacturer_steps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp" />

                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_oem_done"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/setup_step_oem_done"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══ 6. GOTOWE ═══ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/iv_done_check"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_done_circle"
                    android:padding="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_done_check" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/setup_done_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/setup_done_body"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:id="@+id/container_done_checklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_done_lang_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_done_ocr_language_hint"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done_test_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/setup_done_test_overlay_btn"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    app:cornerRadius="24dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done_oem_hints"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    tools:text="Wskazówki dla telefonu"
                    app:cornerRadius="24dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done_finish"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_done_btn"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </ViewFlipper>

</LinearLayout>
