<?xml version="1.0" encoding="utf-8"?>
<!--
    Prominent Disclosure screen (KD4, Task 3.1).

    Layout wymagania:
    - Full screen, body scrollable (tekst > 300 słów).
    - 2 przyciski na dole IDENTYCZNE wizualnie (kolor, rozmiar) —
      „Rozumiem, kontynuuj" i „Anuluj". Play policy wymaga parity.
    - PP link nad przyciskami.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_disclosure_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disclosure_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_disclosure_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disclosure_subtitle"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <TextView
                    android:id="@+id/tv_disclosure_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="@string/disclosure_body"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:lineSpacingMultiplier="1.25" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_privacy_policy_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_pp_link"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:gravity="center"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!--
                KD4 Play policy: oba przyciski IDENTYCZNE wizualnie (rozmiar, kolor, kontrast).
                Różnica tylko w tekście — żeby nie było dark pattern (Cancel wypłowiały,
                Accept wyróżniony). Oba = filled primary.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_disclosure_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/disclosure_button_cancel"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_disclosure_accept"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/disclosure_button_accept"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
