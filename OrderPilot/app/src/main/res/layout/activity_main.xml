<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Nagłówek: nazwa + checklista + zębatka -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/on_background"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btn_check_setup"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_checklist"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/setup_check_settings"
            app:tint="@color/on_surface_variant"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_open"
            app:tint="@color/on_surface_variant" />

    </LinearLayout>

    <!-- Karta statusu -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/status_dot"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_stopped"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_status_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_subtitle_stopped"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/outline_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/main_platforms_caption"
                android:textSize="13sp"
                android:letterSpacing="0.03"
                android:textColor="@color/on_surface_variant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Przycisk START/STOP -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_start"
        android:textSize="17sp"
        android:textAllCaps="false"
        android:layout_marginTop="28dp"
        app:cornerRadius="28dp" />

    <!-- Hint o notyfikacjach — widoczny gdy POST_NOTIFICATIONS denied -->
    <TextView
        android:id="@+id/tv_notification_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_notifications_disabled"
        android:textSize="12sp"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

    <!-- Hint o dostepnosci — widoczny tylko gdy accessibility wylaczone -->
    <LinearLayout
        android:id="@+id/layout_accessibility_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_accessibility_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/accessibility_hint"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant"
            android:gravity="center" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Poleć kumplowi — najtańszy kanał wzrostu (kurierzy siedzą razem na strefach) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share_app"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/share_app_btn"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:cornerRadius="24dp" />

    <!-- Diagnostyka: jedyny kanał logów przy zero-telemetrii — celowo dyskretny -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_logs"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/btn_save_logs"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:textColor="@color/on_surface_variant" />

</LinearLayout>
