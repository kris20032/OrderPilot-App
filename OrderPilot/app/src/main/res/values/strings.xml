    <!-- Samsung -->
    <string name="setup_samsung_step1">Otwórz info o aplikacji → kliknij „Bateria" → ustaw „Bez ograniczeń"</string>
    <string name="setup_samsung_step1_btn">Otwórz info o aplikacji</string>
    <string name="setup_samsung_step2">Ustawienia → Pielęgnacja urządzenia → Bateria → Limity użycia w tle → usuń OrderPilot z list „Aplikacje usypiane" i „Głęboko usypiane"</string>
    <string name="setup_samsung_step2_btn">Otwórz ustawienia baterii</string>
    <string name="setup_samsung_step3">Wyłącz „Usypiaj nieużywane aplikacje" w tym samym ekranie</string>

    <!-- Xiaomi / Redmi / POCO -->
    <string name="setup_xiaomi_step1">Włącz Autostart — pozwala aplikacji uruchomić się automatycznie po restarcie telefonu</string>
    <string name="setup_xiaomi_step1_btn">Otwórz Autostart</string>
    <string name="setup_xiaomi_step2">Ustawienia → Aplikacje → OrderPilot → Oszczędzanie baterii → ustaw „Bez ograniczeń"</string>
    <string name="setup_xiaomi_step2_btn">Otwórz ustawienia baterii</string>
    <string name="setup_xiaomi_step3">Otwórz listę ostatnich aplikacji (kwadratowy przycisk na dole) → znajdź OrderPilot → przesuń w dół lub przytrzymaj → kliknij kłódkę</string>

    <!-- Huawei / Honor -->
    <string name="setup_huawei_step1">Ustawienia → Bateria → Uruchamianie aplikacji → znajdź OrderPilot → wyłącz „Zarządzaj automatycznie" → włącz wszystkie 3 przełączniki ręcznie (autostart, działanie w tle, aktywność w tle)</string>
    <string name="setup_huawei_step1_btn">Otwórz ustawienia baterii</string>
    <string name="setup_huawei_step2">Ustawienia → Aplikacje → OrderPilot → Bateria → „Nie optymalizuj"</string>
    <string name="setup_huawei_step2_btn">Otwórz info o aplikacji</string>

    <!-- Oppo / Realme -->
    <string name="setup_oppo_step1">Info o aplikacji → Bateria → włącz „Zezwalaj na działanie w tle"</string>
    <string name="setup_oppo_step1_btn">Otwórz info o aplikacji</string>
    <string name="setup_oppo_step2">Info o aplikacji → włącz „Automatyczne uruchamianie" (Auto-launch)</string>
    <string name="setup_oppo_step2_btn">Otwórz info o aplikacji</string>
    <string name="setup_oppo_step3">Ustawienia → Bateria → Zarządzanie baterią → OrderPilot → włącz autostart i aktywność w tle</string>

    <!-- OnePlus -->
    <string name="setup_oneplus_step1">Ustawienia → Aplikacje → Specjalny dostęp → Optymalizacja baterii → znajdź OrderPilot → ustaw „Nie optymalizuj"</string>
    <string name="setup_oneplus_step1_btn">Otwórz optymalizację baterii</string>
    <string name="setup_oneplus_step2">Ustawienia → Bateria → Zaawansowana optymalizacja → wyłącz „Głęboka optymalizacja"</string>
    <string name="setup_oneplus_step2_btn">Otwórz ustawienia baterii</string>
    <string name="setup_oneplus_step3">Otwórz listę ostatnich aplikacji → znajdź OrderPilot → przytrzymaj → kliknij kłódkę</string>

