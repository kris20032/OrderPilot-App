<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_background"
    android:padding="16dp">

    <!-- Badge "Dostawa" -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/badge_delivery"
        android:textColor="@color/badge_text"
        android:textStyle="bold"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/badge_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Close button X -->
    <Button
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="✕"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/close_button_bg"
        android:padding="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="22,56 zł"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnClose" />

    <!-- Time and distance -->
    <TextView
        android:id="@+id/tvTimeDistance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Łącznie 30 min (6.4 km)"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_clock"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pickup address -->
    <TextView
        android:id="@+id/tvPickup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Carrefour (Przywidzka 6)"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_pickup_dot"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTimeDistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dropoff address -->
    <TextView
        android:id="@+id/tvDropoff"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aleksandry Gabrysiak, Gdańsk"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_dropoff_square"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPickup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Accept button -->
    <Button
        android:id="@+id/btnAccept"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/btn_accept"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/uber_green"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvDropoff"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Progress bar (timer) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="1000"
        android:progress="1000"
        android:progressTint="@color/uber_green"
        android:progressBackgroundTint="@color/progress_background"
        app:layout_constraintTop_toBottomOf="@id/btnAccept"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
