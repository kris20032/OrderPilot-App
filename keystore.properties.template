# Release signing config — template
#
# INSTRUKCJA:
# 1. Skopiuj ten plik jako `keystore.properties` (w tym samym folderze, czyli root repo)
# 2. Wypełnij pola poniżej swoimi wartościami
# 3. NIE commituj `keystore.properties` — jest w .gitignore
# 4. Plik .jks trzymaj w `keystore/` (też w .gitignore) + backup na chmurze/pendrive
#
# Jeśli ten plik nie istnieje, build release zadziała bez podpisu (debug signing) —
# AAB do Play Store wymaga prawdziwego podpisu, więc `keystore.properties` musi istnieć
# żeby zbudować wersję produkcyjną.

storeFile=keystore/orderpilot-release.jks
storePassword=TWOJE_HASLO_DO_KEYSTORE
keyAlias=orderpilot
keyPassword=TWOJE_HASLO_DO_KLUCZA
